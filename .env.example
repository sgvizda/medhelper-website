# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URI=postgres://medhelper:change-me@localhost:5432/medhelper

# ─── Payload CMS ─────────────────────────────────────────────
# Long random string (e.g. `openssl rand -hex 32`). Never commit a real value.
PAYLOAD_SECRET=replace-with-a-long-random-string

# ─── Site URLs ───────────────────────────────────────────────
# Public URL of this website (no trailing slash). Used for canonical URLs, sitemap, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Fallback URL of the AI platform (login / app). Editable in CMS → Налаштування сайту.
AI_PLATFORM_URL=https://app.example.com

# ─── Email notifications (optional) ──────────────────────────
# If SMTP_HOST is empty, leads are still saved to the database, but no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="MedHelper <no-reply@example.com>"
# Where new lead notifications are delivered
EMAIL_TO=admin@example.com

# ─── Media storage (optional S3-compatible) ──────────────────
# Leave S3_BUCKET empty to store uploads on local disk (./media).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Public base URL for media served from the bucket/CDN (optional)
S3_PUBLIC_URL=

# ─── Security ────────────────────────────────────────────────
# Max contact form submissions per IP per 10 minutes
LEAD_RATE_LIMIT=5

# ─── Docker Compose (production) ─────────────────────────────
POSTGRES_USER=medhelper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medhelper
DOMAIN=medhelper.example.com
